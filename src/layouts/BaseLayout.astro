---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LoadingScreen from "../components/LoadingScreen.jsx";
import "../styles/global.css";

const { pageTitle } = Astro.props;
---

<html lang="es" class="is-loading">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <script is:inline>
      // Blocking script to prevent Flash of Unstyled Content (FOUC)
      (function () {
        const hasVisited = sessionStorage.getItem("hasVisitedCheito");
        if (hasVisited) {
          // If already visited, remove the loading state instantly
          document.documentElement.classList.remove("is-loading");
        }
        // In case of doubt (first visit), the SSR 'is-loading' class remains active
      })();
    </script>
  </head>
  <body>
    <LoadingScreen client:load />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/menu.js";
    </script>
  </body>
</html>
